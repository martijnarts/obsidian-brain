# Environment for obsidian-brain, in KEY=value form. The server does not
# read this file itself: use it as a systemd EnvironmentFile, or load it in
# your shell. docs/configuration.md describes every variable.

# Where the indexes and the model cache live.
# Default: $XDG_DATA_HOME/obsidian-brain, else ~/.local/share/obsidian-brain
#DATA_DIR=/path/to/data

# The embedding model preset: english (default), english-fast,
# english-quality, multilingual, multilingual-quality, multilingual-ollama.
#EMBEDDING_PRESET=english

# A model id. It overrides EMBEDDING_PRESET.
#EMBEDDING_MODEL=Xenova/bge-base-en-v1.5

# transformers (the default) runs the model in the server; ollama uses an
# Ollama server.
#EMBEDDING_PROVIDER=ollama
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_EMBEDDING_DIM=768

# Unload the local model after this many idle milliseconds. 0 keeps it.
#OBSIDIAN_BRAIN_EMBEDDER_IDLE_MS=600000

# 1 turns the file watcher off; then run `obsidian-brain index` on a timer.
#OBSIDIAN_BRAIN_NO_WATCH=1

# The log filter, in tracing EnvFilter syntax.
#OBSIDIAN_BRAIN_LOG=info
