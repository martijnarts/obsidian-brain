{
  "name": "obsidian-brain",
  "version": "1.7.24",
  "mcpName": "io.github.sweir1/obsidian-brain",
  "description": "Standalone Node MCP server: semantic search + knowledge graph + vault editing for Obsidian, no plugin required.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "sweir1",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "semantic-search",
    "knowledge-graph",
    "embeddings",
    "claude",
    "claude-desktop",
    "claude-code",
    "vault",
    "markdown",
    "graphology",
    "sqlite"
  ],
  "homepage": "https://github.com/sweir1/obsidian-brain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweir1/obsidian-brain.git"
  },
  "bugs": {
    "url": "https://github.com/sweir1/obsidian-brain/issues"
  },
  "bin": {
    "obsidian-brain": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "data/seed-models.json",
    "scripts/install.sh",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "cli": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:python": "python3 -m unittest discover -s test/scripts -p 'test_*.py' -v",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "docs": "cd website && mkdocs serve --dev-addr 127.0.0.1:8000",
    "docs:build": "cd website && mkdocs build --strict",
    "gen-docs": "node scripts/gen-docs.mjs",
    "gen-tools-docs": "tsx scripts/gen-tools-docs.mjs",
    "gen-readme-recent": "node scripts/gen-readme-recent.mjs",
    "check-plugin": "node scripts/check-plugin-version.mjs",
    "idea": "node scripts/idea.mjs",
    "embedder:baseline": "node scripts/embedder-baseline.mjs",
    "build:seed": "python3 scripts/build-seed.py",
    "check-env-vars": "node scripts/check-env-vars.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:fix": "npm run gen-docs && npm run gen-tools-docs && npm run gen-readme-recent && npm run preflight",
    "promote": "node scripts/promote.mjs",
    "setup:protection": "node scripts/setup-branch-protection.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "npm rebuild better-sqlite3 || (echo 'obsidian-brain: postinstall rebuild of better-sqlite3 FAILED — your install may crash on first boot. Run `npm rebuild better-sqlite3` manually, or `rm -rf ~/.npm/_npx` and retry. See https://sweir1.github.io/obsidian-brain/troubleshooting/#err_dlopen_failed-node_module_version-mismatch' 1>&2; exit 1)",
    "preversion": "npm run gen-docs -- --check && npm run gen-tools-docs -- --check && npm run gen-readme-recent -- --check && npm run check-plugin",
    "version": "node scripts/sync-server-version.mjs && node scripts/gen-readme-recent.mjs && git add server.json README.md",
    "postversion": "git push --follow-tags"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.2",
    "graphology-types": "^0.24.8",
    "gray-matter": "^4.0.3",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
